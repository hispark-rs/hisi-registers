// Minimal SDK-first WS53 integration map. Additional peripherals are added only
// after their concrete variant and acore/control-core ownership are reconciled.
enum ws53_wdt_expiry_mode {
    ResetOnFirst = 0 { desc = "Reset on first expiry interrupt when RST_EN is set"; };
    ResetOnSecond = 1 { desc = "Reset on second expiry interrupt when RST_EN is set"; };
};
enum ws53_rtc_mode {
    OneShot = 0 { desc = "SDK one-shot mode"; };
    Periodic = 1 { desc = "SDK periodic mode"; };
    OneShotAlternate = 2 { desc = "SDK alias of one-shot mode"; };
    FreeRun = 3 { desc = "SDK free-run mode"; };
};
enum ws53_pwm_interrupt_enable {
    Disabled = 0 { desc = "Both event outputs masked"; };
    AbnormalOnly = 1 { desc = "Enable abnormal configuration event"; };
    PeriodEndOnly = 2 { desc = "Enable step end event"; };
    AllEvents = 3 { desc = "Enable both event outputs; SDK initialization value"; };
};
addrmap ws53 {
    hisi_evidence = "licensed-sdk: fbb_ws53 163d9150ab94a02d09a05f623351f9facee3025e; ws53_liteos_app; acore MCU_MODE_1";
    ws53_system_memory_regs system_memory @ 0x57030000;
    ws53_m_crg_regs m_crg @ 0x52000000;
    ws53_glb_ctl_regs glb_ctl @ 0x57000000;
    ws53_pinmux_mcu_regs pinmux_mcu @ 0x52008000;
    ws53_pinmux_aon_regs pinmux_aon @ 0x57036000;
    ws53_pinmux_tzpc_regs pinmux_tzpc @ 0x5703A000;
    ws53_spi0_v151_100_regs spi0 @ 0x52087000;
    ws53_qspi1_v151_100_regs qspi1 @ 0x5208D000;
    ws53_mdma_v151_regs mdma @ 0x52070000;
    ws53_adc_v155_regs adc @ 0x5208A000;
    ws53_mcu_diag_regs mcu_diag @ 0x52004100;
    ws53_tsensor_regs tsensor @ 0x59006300;
    ws53_sdio_v151_regs sdio @ 0x52060000;
    ws53_trng_regs trng @ 0x52024000;
    ws53_efuse_read_regs efuse @ 0x57024000;
    watchdog_v151_regs #(.SDK_VIEW(true)) wdt @ 0x5702B000;
    wdt->hisi_reset_unverified = true;
    wdt->hisi_evidence = "SDK-source 163d9150 acore watchdog v151, base from acore/platform_core.h; no silicon reset or NMI route validation";
    wdt.WDT_RESTART.wdt_restart->desc = "SDK kick writes 0x5A5A5A5A; other keys have contradictory SDK comments and are not specified";
    wdt.WDT_RESTART.wdt_restart->hisi_write_min = 0x5a5a5a5a;
    wdt.WDT_RESTART.wdt_restart->hisi_write_max = 0x5a5a5a5a;
    wdt.WDT_STATUS.wdt_status->desc = "SDK register definition: 0 free, 1 busy";
    wdt.WDT_EOI.wdt_eoi->onread = ruser;
    wdt.WDT_EOI.wdt_eoi->hisi_svd_read_action = "modifyExternal";
    wdt.WDT_EOI.wdt_eoi->desc = "Read returns zero and clears interrupt per SDK register comment; SDK clear helper reads then writes 1, independent write-only clear behavior unverified";
    wdt.WDT_CR.wdt_mode->desc = "0 reset on first expiry interrupt, 1 reset on second expiry interrupt; reset still gated by RST_EN";
    wdt.WDT_CR.wdt_mode->encode = ws53_wdt_expiry_mode;
    sfc_v150_regs sfc_cfg @ 0x53000000;
    pwm_v151_regs pwm @ 0x52082000;
    pwm->hisi_reset_unverified = true;
    pwm->hisi_evidence = "SDK-source 163d9150 PWM v151 acore profile: 4 groups, 8 channels; no silicon reset, waveform or command readback verified";
    pwm.PWM_INT_MASK.pwm_int_mask->encode = ws53_pwm_interrupt_enable;
    pwm.PWM_INT_MASK.pwm_int_mask->desc = "Event enable despite MASK name: bit0 abnormal, bit1 step end; 1 permits, 0 masks, confirmed by SDK init writing 3";
    pwm.PWM_START0.pwm_start_0->desc = "Commit group 0 configuration with 1; SDK has no completion poll, self-clear/readback timing unverified";
    pwm.PWM_START1.pwm_start_1->desc = "Commit group 1 configuration with 1; SDK has no completion poll, self-clear/readback timing unverified";
    pwm.PWM_START2.pwm_start_2->desc = "Commit group 2 configuration with 1; SDK has no completion poll, self-clear/readback timing unverified";
    pwm.PWM_START3.pwm_start_3->desc = "Commit group 3 configuration with 1; SDK has no completion poll, self-clear/readback timing unverified";
    pwm.PWM_START0.pwm_start_0->hisi_write_min = 1;
    pwm.PWM_START0.pwm_start_0->hisi_write_max = 1;
    pwm.PWM_START1.pwm_start_1->hisi_write_min = 1;
    pwm.PWM_START1.pwm_start_1->hisi_write_max = 1;
    pwm.PWM_START2.pwm_start_2->hisi_write_min = 1;
    pwm.PWM_START2.pwm_start_2->hisi_write_max = 1;
    pwm.PWM_START3.pwm_start_3->hisi_write_min = 1;
    pwm.PWM_START3.pwm_start_3->hisi_write_max = 1;
    pwm.PWM_ABNOR_STATE_CLR0.pwm_abnor_state_clr0->desc = "SDK writes observed abnormal-group bits to acknowledge their events; command readback/self-clear timing unverified";
    pwm.PWM_ABNOR_STATE_CLR1.pwm_abnor_state_clr1->desc = "SDK writes observed abnormal-count bits to acknowledge their events; command readback/self-clear timing unverified";
    pwm.PWM_CFG_INT_CLR0.pwm_cfg_int_clr0->desc = "SDK writes channel bit to acknowledge step-end event; command readback/self-clear timing unverified";
    uart_v151_basic_regs #(.MMIO_WIDTH(32), .SDK_VIEW(true)) uart0 @ 0x52081000;
    uart_v151_basic_regs #(.MMIO_WIDTH(32), .SDK_VIEW(true)) uart1 @ 0x52080000;
    uart_v151_basic_regs #(.MMIO_WIDTH(32), .SDK_VIEW(true)) uart2 @ 0x57014000;
    uart0->hisi_reset_unverified = true;
    uart0.RX_FIFO_WRITE.rx_fifo_write->sw = w;
    uart0.RX_FIFO_WRITE.rx_fifo_write->desc = "Push test data only in FIFO access mode; no read-level alias established on WS53";
    uart0.MODEM_STATUS.dcts->onread = rclr;
    uart0.LINE_STATUS.frame_err->onread = rclr;
    uart0.LINE_STATUS.parity_err->onread = rclr;
    uart0.LINE_STATUS.overrun_err->onread = rclr;
    uart0.LINE_STATUS.rx_fifo_err->onread = ruser;
    uart0.LINE_STATUS.rx_fifo_err->hisi_svd_read_action = "modify";
    uart0.LINE_STATUS.rx_fifo_err->desc = "Read can clear only when the errored character is at FIFO head and no later errors remain";
    uart0.TX_FIFO_READ.tx_fifo_read->onread = ruser;
    uart0.TX_FIFO_READ.tx_fifo_read->hisi_svd_read_action = "modifyExternal";
    uart1->hisi_reset_unverified = true;
    uart1.RX_FIFO_WRITE.rx_fifo_write->sw = w;
    uart1.RX_FIFO_WRITE.rx_fifo_write->desc = "Push test data only in FIFO access mode; no read-level alias established on WS53";
    uart1.MODEM_STATUS.dcts->onread = rclr;
    uart1.LINE_STATUS.frame_err->onread = rclr;
    uart1.LINE_STATUS.parity_err->onread = rclr;
    uart1.LINE_STATUS.overrun_err->onread = rclr;
    uart1.LINE_STATUS.rx_fifo_err->onread = ruser;
    uart1.LINE_STATUS.rx_fifo_err->hisi_svd_read_action = "modify";
    uart1.LINE_STATUS.rx_fifo_err->desc = "Read can clear only when the errored character is at FIFO head and no later errors remain";
    uart1.TX_FIFO_READ.tx_fifo_read->onread = ruser;
    uart1.TX_FIFO_READ.tx_fifo_read->hisi_svd_read_action = "modifyExternal";
    uart2->hisi_reset_unverified = true;
    uart2.RX_FIFO_WRITE.rx_fifo_write->sw = w;
    uart2.RX_FIFO_WRITE.rx_fifo_write->desc = "Push test data only in FIFO access mode; no read-level alias established on WS53";
    uart2.MODEM_STATUS.dcts->onread = rclr;
    uart2.LINE_STATUS.frame_err->onread = rclr;
    uart2.LINE_STATUS.parity_err->onread = rclr;
    uart2.LINE_STATUS.overrun_err->onread = rclr;
    uart2.LINE_STATUS.rx_fifo_err->onread = ruser;
    uart2.LINE_STATUS.rx_fifo_err->hisi_svd_read_action = "modify";
    uart2.LINE_STATUS.rx_fifo_err->desc = "Read can clear only when the errored character is at FIFO head and no later errors remain";
    uart2.TX_FIFO_READ.tx_fifo_read->onread = ruser;
    uart2.TX_FIFO_READ.tx_fifo_read->hisi_svd_read_action = "modifyExternal";
    uart1->hisi_svd_derived_from = "UART0";
    uart2->hisi_svd_derived_from = "UART0";
    i2c_v151_ws53_bs2x_regs i2c0 @ 0x52083000;
    i2c_v151_ws53_bs2x_regs i2c1 @ 0x52084000;
    rtc_v150_ws53_bs2x_regs rtc0 @ 0x57029100;
    rtc_v150_ws53_bs2x_regs rtc1 @ 0x57029200;
    // Source SDK 163d9150 RTC v150: two configured 32-bit channels, not
    // four physical instances merely because the port enum has capacity four.
    // Keep BS2X inherited output unchanged; these are WS53 access corrections.
    rtc0->hisi_reset_unverified = true;
    rtc1->hisi_reset_unverified = true;
    rtc0->hisi_evidence = "SDK-source RTC v150; ws53_liteos_app 32-bit profile, IRQ49; ROM execution and ownership unverified";
    rtc1->hisi_evidence = "SDK-source RTC v150; ws53_liteos_app 32-bit profile, IRQ50; ROM execution and ownership unverified";
    rtc0.CONTROL.mode->encode = ws53_rtc_mode;
    rtc1.CONTROL.mode->encode = ws53_rtc_mode;
    rtc0.CONTROL.cnt_lock->sw = r;
    rtc1.CONTROL.cnt_lock->sw = r;
    rtc0.CONTROL.cnt_lock->desc = "Snapshot ready status, polled after CNT_REQ; no software setter in SDK";
    rtc1.CONTROL.cnt_lock->desc = "Snapshot ready status, polled after CNT_REQ; no software setter in SDK";
    rtc0.RAW_INTR.int_status->sw = r;
    rtc1.RAW_INTR.int_status->sw = r;
    rtc0.INTR.int_status->sw = r;
    rtc1.INTR.int_status->sw = r;
    rtc0.EOI_REN.eoi->sw = w;
    rtc1.EOI_REN.eoi->sw = w;
    rtc0.EOI_REN.eoi->hisi_write_min = 1;
    rtc0.EOI_REN.eoi->hisi_write_max = 1;
    rtc1.EOI_REN.eoi->hisi_write_min = 1;
    rtc1.EOI_REN.eoi->hisi_write_max = 1;
    rtc0.EOI_REN.eoi->desc = "SDK acknowledges by writing one. Header claims read-clear but driver never reads; read behavior withheld";
    rtc1.EOI_REN.eoi->desc = "SDK acknowledges by writing one. Header claims read-clear but driver never reads; read behavior withheld";
    sio_v151_regs i2s @ 0x52030000;
    timer_v150_regs #(.CHANNELS(2), .COMMON_REGS(false), .LOCAL_MASKED_STATUS(true)) timer @ 0x52002000;
    tcxo_v150_data16_regs tcxo @ 0x57000200;
    timer->hisi_reset_unverified = true;
    tcxo->hisi_reset_unverified = true;
    timer.TIMER_EOI0.eoi->desc = "Write one to acknowledge channel 0; read semantics unverified, no read API";
    timer.TIMER_EOI1.eoi->desc = "Write one to acknowledge channel 1; read semantics unverified, no read API";
    // SDK gpio_porting.h: group widths 23/12/3; not WS63's 8-bit banks.
    gpio_v150_basic_regs #(.WIDTH(23), .SOURCE_SELECT(true), .RAW_BITMAP(true)) gpio0 @ 0x5700C000;
    gpio_v150_basic_regs #(.WIDTH(12), .SOURCE_SELECT(true), .RAW_BITMAP(true)) gpio1 @ 0x57028000;
    gpio_v150_basic_regs #(.WIDTH(3), .SOURCE_SELECT(true), .RAW_BITMAP(true)) gpio2 @ 0x57010000;
    gpio0->hisi_reset_unverified = true;
    gpio1->hisi_reset_unverified = true;
    gpio2->hisi_reset_unverified = true;
    gpio0->hisi_evidence = "SDK-source 163d9150 GPIO v150 basic 32-bit slots; bank width 23 includes unusable bit positions, not 23 independent pads; reset unknown";
    gpio1->hisi_evidence = "SDK-source 163d9150 GPIO v150 basic 32-bit slots; AGPIO0..11, physical aliases must be canonicalized; reset unknown";
    gpio2->hisi_evidence = "SDK-source 163d9150 GPIO v150 basic 32-bit slots; SGPIO0..2 = physical MGPIO14/15/21, debug reservation required; reset unknown";
    gpio0.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio1.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio2.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio0.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio1.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio2.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio0.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;
    gpio1.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;
    gpio2.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;

    // acore/chip_core_irq.h: LOCAL_INTERRUPT0 = 26. These are absolute
    // mcause values, not offsets into a PLIC or Cortex-M vector table.
    signal { hisi_irq_number = 29; hisi_irq_owner = "GPIO2"; } SGPIO_INT;
    signal { hisi_irq_number = 33; hisi_irq_owner = "GPIO1"; } GPIO_1;
    signal { hisi_irq_number = 34; hisi_irq_owner = "GPIO0"; } GPIO_0;
    signal { hisi_irq_number = 39; hisi_irq_owner = "UART0"; } UART_0;
    signal { hisi_irq_number = 41; hisi_irq_owner = "UART1"; } UART_1;
    signal { hisi_irq_number = 42; hisi_irq_owner = "UART2"; } UART_2;
    signal { hisi_irq_number = 43; hisi_irq_owner = "QSPI1"; } QSPI0_2CS;
    signal { hisi_irq_number = 46; hisi_irq_owner = "SDIO"; } SDIO;
    signal { hisi_irq_number = 49; hisi_irq_owner = "RTC0"; } RTC_0;
    signal { hisi_irq_number = 50; hisi_irq_owner = "RTC1"; } RTC_1;
    signal { hisi_irq_number = 53; hisi_irq_owner = "TIMER"; } TIMER_0;
    signal { hisi_irq_number = 54; hisi_irq_owner = "TIMER"; } TIMER_1;
    signal { hisi_irq_number = 58; hisi_irq_owner = "MDMA"; } M_DMA;
    signal { hisi_irq_number = 62; hisi_irq_owner = "I2C0"; } I2C_0;
    signal { hisi_irq_number = 63; hisi_irq_owner = "I2C1"; } I2C_1;
    signal { hisi_irq_number = 65; hisi_irq_owner = "SPI0"; } SPI_3;
    signal { hisi_irq_number = 67; hisi_irq_owner = "I2S"; } I2S;
    signal { hisi_irq_number = 71; hisi_irq_owner = "PWM"; } PWM_ABNOR;
    signal { hisi_irq_number = 72; hisi_irq_owner = "PWM"; } PWM_CFG;
    // IRQ number only: selected v155 SDK handler is empty (polling capture).
    signal { hisi_irq_number = 80; hisi_irq_owner = "ADC"; } LSADC;
};
