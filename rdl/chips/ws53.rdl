    gpio1->hisi_evidence = "SDK-source 163d9150 GPIO v150 basic 32-bit slots; AGPIO0..11, physical aliases must be canonicalized; reset unknown";
    gpio2->hisi_evidence = "SDK-source 163d9150 GPIO v150 basic 32-bit slots; SGPIO0..2 = physical MGPIO14/15/21, debug reservation required; reset unknown";
    gpio0.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio1.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio2.GPIO_INT_EOI.gpio_int_eoi->onwrite = woclr;
    gpio0.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio1.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio2.GPIO_DATA_SET.gpio_data_set->onwrite = woset;
    gpio0.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;
    gpio1.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;
    gpio2.GPIO_DATA_CLR.gpio_data_clr->onwrite = woclr;

    // acore/chip_core_irq.h: LOCAL_INTERRUPT0 = 26. These are absolute
    // mcause values, not offsets into a PLIC or Cortex-M vector table.
    signal { hisi_irq_number = 29; hisi_irq_owner = "GPIO2"; } SGPIO_INT;
    signal { hisi_irq_number = 33; hisi_irq_owner = "GPIO1"; } GPIO_1;
