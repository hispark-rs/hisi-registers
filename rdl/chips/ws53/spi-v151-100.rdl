// and regs_op.h; chips/ws53/porting/spi/spi_porting.c binds base/IRQ and adapter.
// Reset values are not assumed. FIFO reads consume data; interrupt-clear reads
// acknowledge errors. RX/TX views deliberately have no read-modify-write API.

addrmap ws53_spi0_v151_100_regs {
    hisi_evidence = "SDK-source 163d9150 v151_100 registers and operations; application instance; runtime ownership and silicon behavior pending";
    reg {
        field { sw=rw; hw=r; } start[0:0];
    } ENABLE @ 0x0;
