`include "../properties.rdl"
`include "../ip/watchdog-v151.rdl"
`include "../ip/sfc-v150.rdl"
`include "../ip/pwm-v151.rdl"
`include "../ip/i2c-v151-ws53-bs2x.rdl"
`include "../ip/rtc-v150-ws53-bs2x.rdl"
`include "../ip/uart-v151-basic.rdl"
`include "../ip/sio-v151.rdl"
`include "../ip/timer-v150.rdl"
`include "../ip/tcxo-v150-data16.rdl"
`include "../ip/gpio-v150-basic.rdl"
`include "ws53/system-memory.rdl"
`include "ws53/pinctrl.rdl"
`include "ws53/m-crg.rdl"

// Minimal SDK-first WS53 integration map. Additional peripherals are added only
// after their concrete variant and acore/control-core ownership are reconciled.
addrmap ws53 {
    hisi_evidence = "licensed-sdk: fbb_ws53 163d9150ab94a02d09a05f623351f9facee3025e; ws53_liteos_app; acore MCU_MODE_1";
    ws53_system_memory_regs system_memory @ 0x57030000;
    ws53_m_crg_regs m_crg @ 0x52000000;
    ws53_pinmux_mcu_regs pinmux_mcu @ 0x52008000;
    ws53_pinmux_aon_regs pinmux_aon @ 0x57036000;
    ws53_pinmux_tzpc_regs pinmux_tzpc @ 0x5703A000;
    watchdog_v151_regs wdt @ 0x5702B000;
    sfc_v150_regs sfc_cfg @ 0x53000000;
    pwm_v151_regs pwm @ 0x52082000;
    uart_v151_basic_regs uart0 @ 0x52081000;
    uart_v151_basic_regs uart1 @ 0x52080000;
    uart_v151_basic_regs uart2 @ 0x57014000;
    uart1->hisi_svd_derived_from = "UART0";
    uart2->hisi_svd_derived_from = "UART0";
    i2c_v151_ws53_bs2x_regs i2c0 @ 0x52083000;
    i2c_v151_ws53_bs2x_regs i2c1 @ 0x52084000;
    rtc_v150_ws53_bs2x_regs rtc0 @ 0x57029100;
    rtc_v150_ws53_bs2x_regs rtc1 @ 0x57029200;
    sio_v151_regs i2s @ 0x52030000;
    timer_v150_regs #(.CHANNELS(2)) timer @ 0x52002000;
    tcxo_v150_data16_regs tcxo @ 0x57000200;
    // SDK gpio_porting.h: group widths 23/12/3; not WS63's 8-bit banks.
    gpio_v150_basic_regs #(.WIDTH(23)) gpio0 @ 0x5700C000;
    gpio_v150_basic_regs #(.WIDTH(12)) gpio1 @ 0x57028000;
    gpio_v150_basic_regs #(.WIDTH(3)) gpio2 @ 0x57010000;

    // acore/chip_core_irq.h: LOCAL_INTERRUPT0 = 26. These are absolute
    // mcause values, not offsets into a PLIC or Cortex-M vector table.
    signal { hisi_irq_number = 29; hisi_irq_owner = "GPIO2"; } SGPIO_INT;
    signal { hisi_irq_number = 33; hisi_irq_owner = "GPIO1"; } GPIO_1;
    signal { hisi_irq_number = 34; hisi_irq_owner = "GPIO0"; } GPIO_0;
    signal { hisi_irq_number = 39; hisi_irq_owner = "UART0"; } UART_0;
    signal { hisi_irq_number = 41; hisi_irq_owner = "UART1"; } UART_1;
    signal { hisi_irq_number = 42; hisi_irq_owner = "UART2"; } UART_2;
    signal { hisi_irq_number = 49; hisi_irq_owner = "RTC0"; } RTC_0;
    signal { hisi_irq_number = 50; hisi_irq_owner = "RTC1"; } RTC_1;
    signal { hisi_irq_number = 53; hisi_irq_owner = "TIMER"; } TIMER_0;
    signal { hisi_irq_number = 54; hisi_irq_owner = "TIMER"; } TIMER_1;
    signal { hisi_irq_number = 62; hisi_irq_owner = "I2C0"; } I2C_0;
    signal { hisi_irq_number = 63; hisi_irq_owner = "I2C1"; } I2C_1;
    signal { hisi_irq_number = 67; hisi_irq_owner = "I2S"; } I2S;
    signal { hisi_irq_number = 71; hisi_irq_owner = "PWM"; } PWM_ABNOR;
    signal { hisi_irq_number = 72; hisi_irq_owner = "PWM"; } PWM_CFG;
};
