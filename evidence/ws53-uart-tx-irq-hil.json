  "findings": [
    "IIR read returning2 acknowledges TX notification; second IIR read returns1",
    "Disable then enable TX interrupt rearms empty-FIFO IRQ without new data",
    "PTIM0 triggers at empty FIFO; PTIM1 inherited threshold triggers at2 queued bytes",
    "With FIFO and PTIM enabled LSR.THRE_S reports full; otherwise reports empty",
    "TX IRQ can precede serializer completion; flush must check TX_EMPTY_S"
  ],
  "limitations": [
    "Only UART2 physically qualified; UART0/1 and other threshold levels model/source only",
    "Exact interrupt timing, clock faults and production control-core handoff unqualified"
  ],
