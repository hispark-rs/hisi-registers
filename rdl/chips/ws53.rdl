// Minimal SDK-first WS53 integration map. Additional peripherals are added only
// after their concrete variant and acore/control-core ownership are reconciled.
enum ws53_wdt_expiry_mode {
    ResetOnFirst = 0 { desc = "Reset on first expiry interrupt when RST_EN is set"; };
    ResetOnSecond = 1 { desc = "Reset on second expiry interrupt when RST_EN is set"; };
};
enum ws53_rtc_mode {
    OneShot = 0 { desc = "SDK one-shot mode"; };
    Periodic = 1 { desc = "SDK periodic mode"; };
    OneShotAlternate = 2 { desc = "SDK alias of one-shot mode"; };
    FreeRun = 3 { desc = "SDK free-run mode"; };
};
enum ws53_pwm_interrupt_enable {
    Disabled = 0 { desc = "Both event outputs masked"; };
    AbnormalOnly = 1 { desc = "Enable abnormal configuration event"; };
    ConfigurationLoadedOnly = 2 { desc = "Enable configuration-load notification; initial START can also assert it, not proof that a pulse block ended"; };
    AllEvents = 3 { desc = "Enable both event outputs; SDK initialization value"; };
};
