// HiSilicon integration metadata not covered by the SystemRDL 2.0 core model.

property hisi_irq_number {
    type = longint unsigned;
    component = signal;
};

property hisi_irq_owner {
    type = string;
    component = signal;
};

property hisi_evidence {
    type = string;
    component = addrmap | regfile | reg | field | signal;
};

// A reused IP's legacy reset annotations are not necessarily established for
// a new integration. True on any ancestor vetoes resetValue/resetMask export;
// it cannot invent a new reset value or be undone by a child setting false.
property hisi_reset_unverified {
    type = boolean;
    component = addrmap | regfile | reg | field;
};

// Explicit SVD instance reuse. The exporter proves register equivalence before
// emitting derivedFrom; IRQs and base addresses remain instance-specific.
property hisi_svd_derived_from {
    type = string;
    component = addrmap;
};

// Explicit mutually exclusive read/write views at the same address. The
// exporter validates offset, size, dimensions, stride and access directions.
property hisi_svd_alternate_register {
    type = string;
    component = reg;
};

// Explicit little-endian 32-bit access to an existing 16-bit RW register.
// Value names the added SVD view. No new fields or reset values are invented.
// Exporter rejects arrays, side effects, overlap with adjacent registers,
// unsupported sizes and missing evidence. Both views refer to the same state.
property hisi_svd_word_view {
    type = string;
    component = reg;
};

// ruser alone does not specify which CMSIS-SVD side effect applies.
property hisi_svd_read_action {
    type = string;
    component = field;
};

property hisi_write_min {
    type = longint unsigned;
    component = reg | field;
};

property hisi_write_max {
    type = longint unsigned;
    component = reg | field;
};
