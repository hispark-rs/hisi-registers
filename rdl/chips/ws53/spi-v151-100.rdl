        field { sw=rw; hw=r; } instruction_ddr[14:14];
        field { sw=rw; hw=r; } data_ddr[15:15];
    } ENHANCED_CONTROL @ 0xc;
    reg {
        field { sw=rw; hw=r; } handshake[0:0];
        field { sw=rw; hw=r; } sequential[1:1];
        field { sw=rw; hw=r; } transmit[2:2];
    } MICROWIRE @ 0x10;
    reg {
        field { sw=rw; hw=r; } value[15:0];
    } BAUD @ 0x14;
    reg {
        field { sw=rw; hw=r; } tx_enable[0:0];
        field { sw=rw; hw=r; } rx_enable[1:1];
    } DMA_CONTROL @ 0x18;
    reg {
        field { sw=rw; hw=r; } value[31:0];
    } DMA_RX_LEVEL @ 0x1c;
    reg {
        field { sw=rw; hw=r; } value[31:0];
    } DMA_TX_LEVEL @ 0x20;
    reg {
        field { sw=rw; hw=r; } value[7:0];
    } RX_SAMPLE_DELAY @ 0x24;
    reg {
        field { sw=rw; hw=r; } value[7:0];
    } TX_DRIVE_EDGE @ 0x28;
    reg {
        field { sw=r; hw=w; } rx_full[0:0];
        field { sw=r; hw=w; } rx_overflow[1:1];
        field { sw=r; hw=w; } rx_underflow[2:2];
        field { sw=r; hw=w; } tx_empty[7:7];
        field { sw=r; hw=w; } tx_overflow[8:8];
        field { sw=r; hw=w; } multi_master[15:15];
    } RAW_INTERRUPT @ 0xbc;
    reg {
        field { sw=r; hw=w; } rx_full[0:0];
        field { sw=r; hw=w; } rx_overflow[1:1];
        field { sw=r; hw=w; } rx_underflow[2:2];
        field { sw=r; hw=w; } tx_empty[7:7];
        field { sw=r; hw=w; } tx_overflow[8:8];
        field { sw=r; hw=w; } multi_master[15:15];
    } INTERRUPT_STATUS @ 0xc0;
    reg {
        field { sw=rw; hw=r; } rx_full[0:0];
        field { sw=rw; hw=r; } rx_overflow[1:1];
        field { sw=rw; hw=r; } rx_underflow[2:2];
        field { sw=rw; hw=r; } tx_empty[7:7];
        field { sw=rw; hw=r; } tx_overflow[8:8];
        field { sw=rw; hw=r; } multi_master[15:15];
    } INTERRUPT_MASK @ 0xc4;
    reg {
        field { sw=rw; hw=r; } value[15:0];
    } SLAVE_ENABLE @ 0xc8;
    reg {
        field { sw=rw; hw=r; } value[31:0];
    } TX_THRESHOLD @ 0xcc;
    reg {
        field { sw=r; hw=w; } value[31:0];
    } TX_LEVEL @ 0xd0;
    reg {
        field { sw=r; hw=w; onread=rclr; desc="Read acknowledges the corresponding interrupt; writes have no effect"; } clear[0:0];
    } CLEAR_TX_OVERFLOW @ 0xd4;
    reg {
        field { sw=rw; hw=r; } value[31:0];
    } RX_THRESHOLD @ 0xd8;
    reg {
        field { sw=r; hw=w; } value[31:0];
    } RX_LEVEL @ 0xdc;
    reg {
        field { sw=r; hw=w; onread=rclr; desc="Read acknowledges the corresponding interrupt; writes have no effect"; } clear[0:0];
    } CLEAR_RX_UNDERFLOW @ 0xe0;
    reg {
        field { sw=r; hw=w; } collision_or_tx_error[0:0];
        field { sw=r; hw=w; } rx_not_empty[4:4];
        field { sw=r; hw=w; } rx_full[5:5];
        field { sw=r; hw=w; } tx_not_full[11:11];
        field { sw=r; hw=w; } tx_empty[12:12];
        field { sw=r; hw=w; } busy[15:15];
    } STATUS @ 0xe4;
    reg {
        field { sw=r; hw=w; onread=rclr; desc="Read acknowledges the corresponding interrupt; writes have no effect"; } clear[0:0];
    } CLEAR_MULTI_MASTER @ 0xe8;
    reg {
        field { sw=r; hw=w; } value[31:0];
    } VERSION @ 0xec;
    reg {
        field { sw=r; hw=w; onread=rclr; desc="Read acknowledges the corresponding interrupt; writes have no effect"; } clear[0:0];
    } CLEAR_RX_OVERFLOW @ 0xf4;
    reg {
        field { sw=r; hw=w; onread=rclr; desc="Read acknowledges the corresponding interrupt; writes have no effect"; } clear[0:0];
    } CLEAR_ALL @ 0xf8;
    external reg {
        field { sw=r; hw=w; onread=ruser; hisi_svd_read_action="modifyExternal";
            desc="Pop one received frame from the shared RX FIFO, regardless of window index";
        } data[31:0];
    } RX[36] @ 0x2c += 4;
    reg {
        hisi_svd_alternate_register = "RX";
        field { sw=w; hw=r; desc="Push one frame into the shared TX FIFO, regardless of window index"; } data[31:0];
    } TX[36] @ 0x2c += 4;
};

